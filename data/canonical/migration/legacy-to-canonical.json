      },
      {
        "legacy_pattern": "DEMO-C-n",
        "canonical_pattern": "SYN-CASE-n",
        "exception_ids": [
          "DEMO-C-002",
          "DEMO-C-017"
        ]
      }
    ],
    "case_statuses": {
      "已关闭": {
        "type": "direct",
        "target": "已关闭"
      },
      "处理中": {
        "type": "direct",
        "target": "处理中"
      },
      "待验证": {
        "type": "direct",
        "target": "待验证"
      },
      "观察中": {
        "type": "direct",
        "target": "待回访"
      },
      "已分诊": {
        "type": "conditional",
        "condition": "missing_fields.length === 0",
        "when_complete": "待关联",
        "when_incomplete": "待补充"
      },
      "待人工确认": {
        "type": "direct",
        "target": "待关联"
      }
    },
    "work_order_statuses": {
      "已验证": "已完成",
      "已完成": "已完成",
      "处理中": "处理中",
      "待接单": "待接单"
    },
    "cluster_statuses": {
      "观察中": "观察中",
      "处理中": "改进中",
      "已控制": "待审核",
      "待评审": "待审核"
    },
    "association_mode": {
      "自动": "AI候选生成+正式关系待人工确认",
      "人工": "人工候选+正式关系待人工确认",
      "不适用": "不适用"
    }
  },
  "review_items": [
    "旧案件状态“观察中”无关闭时间，初稿迁为“待回访”，长期观察另建改进项目；需主控在契约冻结前复核。",
    "旧问题簇状态“处理中/已控制/待评审”没有计划内逐项映射，初稿分别映为“改进中/待审核/待审核”；需主控复核。",
    "旧工作簿只保存单一优先级，除明确硬规则的 DEMO-C-001 外，rule_risk 暂为空、ai_risk 与 final_risk 保留旧优先级。",
    "仓库 package.json 没有 Excel 解析依赖；本轮使用桌面捆绑 artifact-tool 只读核对，未修改依赖。"
  ],
